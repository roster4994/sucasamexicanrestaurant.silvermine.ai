---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { Image } from 'astro:assets';
import orderBannerImg from '../assets/images/order/chile-verde-dinner.jpg';
import { business, addressLines, hours, hoursRange, ordering } from '../data/business';

const deliveryPartners = [
  { name: "DoorDash", link: ordering.doorDash, color: "#FF3008", logo: "/doordash-logo.svg" },
  { name: "Uber Eats", link: ordering.uberEats, color: "#06C167", logo: "/ubereats-logo.svg" },
  { name: "GrubHub", link: ordering.grubhub, color: "#F63440", logo: "/grubhub-logo.svg" }
];

const siteUrl = 'https://sucasamexicanrestaurant.com';

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteUrl}/order/`,
  "name": "Order Online | Su Casa Mexican Restaurant",
  "description": "Order Su Casa Mexican Restaurant for delivery or pickup through DoorDash, GrubHub, or Uber Eats. Authentic Mexican food delivered to your door in Midvale, Utah.",
  "url": `${siteUrl}/order/`,
  "isPartOf": { "@id": `${siteUrl}/#website` }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Order Online",
      "item": `${siteUrl}/order/`
    }
  ]
};
---

<Layout
  image={orderBannerImg}
  title="Order Mexican Food Online | Su Casa Restaurant Midvale, Utah"
  description={`Order Su Casa's authentic Mexican food for pickup or delivery in Midvale, Utah. Order direct or through DoorDash, GrubHub & Uber Eats. ${business.telephoneDisplay}.`}
>
<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Fragment>
<div class="order-page-wrapper">
  <!-- Banner -->
  <section class="page-banner">
    <Image src={orderBannerImg} alt="Chile verde with warm flour tortillas, rice, and cheese from Su Casa Mexican Restaurant in Midvale" class="banner-image" width={1279} loading="eager" fetchpriority="high" />
  </section>

  <Breadcrumb current="Order Online" />
  <div class="order-content">
    <div class="container">
      <h1>Order Mexican Food Online — Su Casa Midvale, Utah</h1>

      <!-- Main Order Button -->
      <section class="main-order-section">
        <a href={ordering.spotOn} target="_blank" rel="noopener noreferrer" class="main-order-btn">
          DELIVERY & PICK-UP
        </a>
        <p class="order-note">Ordering directly through us supports our small business and lets you pay in-restaurant prices,<br>with third-party delivery options available below for your convenience.</p>
      </section>

      <!-- Delivery Partners -->
      <section class="delivery-section">
        <div class="partners-grid">
          {deliveryPartners.map((partner) => (
            <a href={partner.link} target="_blank" rel="noopener noreferrer" class="partner-card" style={`--partner-color: ${partner.color}`}>
              <img src={partner.logo} alt={partner.name} class="partner-logo" width="200" height="40" loading="lazy" />
            </a>
          ))}
        </div>
      </section>

      <!-- Pickup Option -->
      <section class="pickup-section">
        <div class="pickup-content">
          <div class="pickup-text">
            <h2>Prefer to Call?</h2>
            <a href={business.telephoneHref} class="btn btn-primary">{business.telephoneDisplay}</a>
          </div>
          <div class="pickup-info">
            <h3>Pickup Location</h3>
            <address>{addressLines[0]}<br>{addressLines[1]}</address>
            <p class="pickup-hours">
              <strong>Hours:</strong>
              {hours.map((entry) => (
                <Fragment><br>{entry.label}: {hoursRange(entry, 'short')}</Fragment>
              ))}
            </p>
          </div>
        </div>
      </section>

      <!-- About Ordering -->
      <section class="order-info">
        <h2>Takeout &amp; Delivery from Midvale's Favorite Mexican Restaurant</h2>
        <p>
          Craving enchiladas, fajitas, or our famous chile verde at home? Su Casa makes it easy to enjoy
          authentic, homemade Mexican food anywhere in the Salt Lake Valley. Order directly through our website
          for pickup at our Midvale location on State Street, or have your meal delivered through DoorDash,
          GrubHub, or Uber Eats. Every dish is prepared fresh to order using the same family recipes we've
          served since 1978.
        </p>
        <p>
          Ordering for the office or a family gathering? Give us a call ahead of time and we'll have everything
          hot and ready when you arrive.
        </p>
      </section>

      <!-- Catering CTA -->
      <section class="catering-cta">
        <div class="cta-content">
          <div>
            <h2>Feeding a Group?</h2>
            <p>For large orders or catering needs, contact us directly for special pricing and menu options.</p>
          </div>
          <a href="/catering/" class="btn btn-primary">Catering Info</a>
        </div>
      </section>
    </div>
  </div>
</div>
</Layout>

<style>
  /* Banner */
  .page-banner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 350px;
    overflow: hidden;
    z-index: -1;
  }

  .order-page-wrapper {
    padding-top: 350px;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .order-content {
    padding: var(--spacing-xl) 0;
  }

  .order-content h1 {
    text-align: center;
    color: var(--color-brown-dark);
    margin-bottom: var(--spacing-md);
  }

  /* Main Order Button */
  .main-order-section {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .order-note {
    max-width: 800px;
    margin: var(--spacing-md) auto 0;
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .main-order-btn {
    display: inline-block;
    padding: 1.5rem 4rem;
    background: var(--color-primary);
    color: white;
    font-size: 1.8rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transition: all var(--transition-normal);
    letter-spacing: 0.05em;
    border: 3px solid var(--color-tertiary);
  }

  .main-order-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    background: var(--color-primary-dark);
  }

  /* Delivery Partners */
  .delivery-section {
    margin-bottom: var(--spacing-xl);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacing-lg);
    background: white;
    border: 3px solid var(--partner-color);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-normal);
    min-height: 100px;
  }

  .partner-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--partner-color);
    background: rgba(255, 255, 255, 0.95);
  }

  .partner-logo {
    max-width: 160px;
    height: auto;
    max-height: 50px;
    object-fit: contain;
    transition: transform var(--transition-normal);
  }

  .partner-card:hover .partner-logo {
    transform: scale(1.05);
  }

  /* Pickup Section */
  .pickup-section {
    background: var(--color-teal);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-xl);
  }

  .pickup-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .pickup-text h2 {
    color: white;
    margin-bottom: var(--spacing-sm);
  }

  .pickup-text .btn-primary {
    background: white;
    color: var(--color-teal);
    border-color: white;
  }

  .pickup-text .btn-primary:hover {
    background: var(--color-tertiary);
    border-color: var(--color-tertiary);
    color: var(--color-brown-dark);
  }

  .pickup-info {
    background: white;
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    border-left: 4px solid var(--color-tertiary);
  }

  .pickup-info h3 {
    color: #415f84;
    margin: 0 0 var(--spacing-xs);
    font-size: 1.1rem;
  }

  .pickup-info address {
    font-style: normal;
    color: #415f84;
    margin-bottom: var(--spacing-sm);
  }

  .pickup-hours {
    color: #415f84;
    font-size: 0.9rem;
    margin: 0;
  }

  /* About Ordering */
  .order-info {
    max-width: 800px;
    margin: 0 auto var(--spacing-xl);
    text-align: center;
  }

  .order-info h2 {
    color: var(--color-brown-dark);
    margin-bottom: var(--spacing-sm);
  }

  .order-info p {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--spacing-sm);
  }

  /* Catering CTA */
  .catering-cta {
    background: var(--color-primary);
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
  }

  .catering-cta .cta-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .cta-content h2 {
    color: white;
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  .catering-cta .btn {
    flex-shrink: 0;
    margin-left: auto;
  }

  .catering-cta .btn-primary {
    background: white;
    color: var(--color-primary);
    border-color: white;
  }

  .catering-cta .btn-primary:hover {
    background: var(--color-tertiary);
    border-color: var(--color-tertiary);
    color: var(--color-brown-dark);
  }

  @media (max-width: 768px) {
    .page-banner {
      height: 250px;
    }

    .order-page-wrapper {
      padding-top: 250px;
    }

    .main-order-btn {
      padding: 1.2rem 2.5rem;
      font-size: 1.4rem;
    }

    .pickup-content {
      grid-template-columns: 1fr;
    }

    .catering-cta .cta-content {
      flex-direction: column;
      text-align: center;
    }

    .catering-cta .btn {
      margin-left: 0;
    }
  }
</style>
