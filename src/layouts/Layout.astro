---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
import heroImg from '../assets/images/media/combo-plate-10.jpg';
import { business, restaurantSchema } from '../data/business';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Page hero for og:image / twitter:image. Falls back to the logo. */
  image?: ImageMetadata;
  /** Keep the page out of search results (e.g. form thank-you pages). */
  noindex?: boolean;
}

const { title, description = "Family owned since 1978, Su Casa Mexican Restaurant in Midvale, Utah offers authentic Mexican cuisine in a cozy, festive atmosphere.", image, noindex = false } = Astro.props;

const productionDomain = 'sucasamexicanrestaurant.com';
// GitHub Pages serves directory URLs with a trailing slash and 301s the
// slashless variant, so the canonical must always end in a slash.
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, `https://${productionDomain}`);
const isProduction = import.meta.env.PROD;
const ogImageSrc = image ? (await getImage({ src: image, width: 1200, format: 'jpg' })).src : logoImg.src;
const ogImage = new URL(ogImageSrc, `https://${productionDomain}`).href;

// Stable public logo URL plus an optimized hero photo for the Restaurant node.
const heroPhoto = await getImage({ src: heroImg, width: 1200, format: 'jpg' });
const schemaImages = [
  `${business.url}/media/logo.png`,
  new URL(heroPhoto.src, business.url).href,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Mexican restaurant, Midvale, Utah, authentic Mexican food, tacos, burritos, enchiladas, catering, family restaurant" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Su Casa Mexican Restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo Meta Tags -->
    <meta name="geo.region" content={`US-${business.addressRegion}`} />
    <meta name="geo.placename" content={business.addressLocality} />
    <meta name="geo.position" content={`${business.geo.latitude};${business.geo.longitude}`} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />
    {!isProduction && <meta name="robots" content="noindex, nofollow" />}
    {isProduction && noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Preconnect to ordering platform -->
    <link rel="dns-prefetch" href="https://order.spoton.com" />
    <link rel="preconnect" href="https://order.spoton.com" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema(schemaImages))} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Jost', sans-serif;
  }
</style>
